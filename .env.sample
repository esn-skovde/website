# Supabase: Project Settings -> API -> Project URL and the anon public key. The
# URL looks like https://<project-ref>.supabase.co.
# Leave both empty, as shipped, to run on the sample events and trips in
# src/data/sampleEvents.js. A URL that does not start with http:// or https://
# counts as empty.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Events and trips come from Supabase; with no credentials the Events
# page is empty, so any build without credentials falls back to the sample data
# in src/data/sampleEvents.js and labels the page as such.
# Set to "false" to see the real empty state instead — the deploy workflow does
# this for a root deploy so the live site never shows invented events.
# Ignored when Supabase is configured: real credentials always win.
# VITE_SAMPLE_DATA=false
