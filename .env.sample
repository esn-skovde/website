VITE_SUPABASE_URL=<YOUR_SUPABASE_PROJECT_URL>
VITE_SUPABASE_ANON_KEY=<YOUR_SUPABASE_PROJECT_ANON_KEY>

# Optional. Events and trips come from Supabase; with no credentials the Events
# page is empty, so `npm run dev` falls back to the sample data in
# src/data/sampleEvents.js and labels the page as such.
# Set to "false" to see the real empty state instead.
# Ignored when Supabase is configured. Development only — a production build
# drops the sample data entirely.
# VITE_SAMPLE_DATA=false
